# Copy this file to .env.local and fill in the values.
# For LOCAL Supabase, run `npm run db:start` (or `supabase start`) and copy the
# values it prints. For a hosted project, copy them from the Supabase dashboard
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key used for admin actions (creating users, seeding). NEVER expose
# this to the browser. Only referenced from server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
